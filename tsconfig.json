{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "commonjs",
    "target": "ES2023",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",

    "paths": {
      "@/*": ["./src/*"]
    },
  }
}